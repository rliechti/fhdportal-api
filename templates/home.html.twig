<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FEGA API - Debug Tools</title>
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
</head>
<body>
    <div class="container">
        <header>
            <h1>FEGA API - Debug Tools</h1>
        </header>

        <main>
            <section class="card">
                <h2>Resource Validation</h2>
                <div class="form-group">
                    <label for="resource-type">Resource Type:</label>
                    <select id="resource-type" class="form-control">
                        <option value="">----------</option>
                        <option value="Dataset">Dataset</option>
                        <option value="MolecularAnalysis">Analysis</option>
                        <option value="MolecularExperiment">Experiment</option>
                        <option value="MolecularRun">Run</option>
                        <option value="Sample">Sample</option>
                        <option value="Study">Study</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="validation-input">JSON or Value-Delimited Data:</label>
                    <textarea id="validation-input" rows="8"></textarea>
                </div>
                <div class="form-group">
                    <label for="file-upload">Or Upload File:</label>
                    <input type="file" id="file-upload" class="form-control" accept=".json,.tsv,.csv,.txt">
                </div>
                <div class="button-group">
                    <button id="validate-button" class="btn btn-primary">Validate</button>
                    <button id="clear-validation-button" class="btn btn-secondary">Clear</button>
                </div>
                <div id="validation-result" class="result-container"></div>
            </section>

            <section class="card">
                <h2>Submission Bundle Validation</h2>
                <div class="form-group">
                    <label for="bundle-upload">Upload Submission Bundle:</label>
                    <input type="file" id="bundle-upload" class="form-control" accept=".zip">
                </div>
                <div class="button-group">
                    <button id="validate-bundle-button" class="btn btn-primary">Validate</button>
                    <button id="clear-bundle-button" class="btn btn-secondary">Clear</button>
                </div>
                <div id="bundle-result" class="result-container"></div>
            </section>

            <section class="card">
                <h2>Auth Token Decoding</h2>
                <div class="form-group">
                    <label for="token-input">JWT Token:</label>
                    <textarea id="token-input" placeholder="Paste your JWT token here..." rows="4"></textarea>
                </div>
                <div class="button-group">
                    <button id="decode-button" class="btn btn-primary">Decode</button>
                    <button id="clear-token-button" class="btn btn-secondary">Clear</button>
                </div>
                <div id="token-result" class="result-container"></div>
            </section>
        </main>
    </div>

    <script src="{{ asset('js/home.js') }}"></script>
</body>
</html>
